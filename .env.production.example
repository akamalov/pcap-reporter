# Production Environment Configuration
# Copy this file to .env.production and customize values

# =============================================================================
# SECURITY SETTINGS - MUST BE CHANGED IN PRODUCTION
# =============================================================================

# Strong secret keys (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-this-in-production-256-bits-long
JWT_SECRET=your-jwt-secret-key-change-this-in-production-256-bits-too

# MongoDB credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=super-secure-mongo-password-change-this
MONGO_PASSWORD=super-secure-mongo-password-change-this

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=secure-grafana-password-change-this

# Flower monitoring credentials
FLOWER_USER=admin
FLOWER_PASSWORD=secure-flower-password-change-this

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=production
NODE_ENV=production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# File Upload Settings
UPLOAD_MAX_SIZE=104857600  # 100MB in bytes
UPLOAD_PATH=/app/uploads
UPLOAD_ALLOWED_EXTENSIONS=.pcap,.pcapng,.cap

# Database Configuration
DATABASE_URL=mongodb://admin:${MONGO_PASSWORD}@mongodb:27017/pcap_reporter?authSource=admin&ssl=false&retryWrites=true&w=majority

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# FRONTEND SETTINGS
# =============================================================================

# Frontend URLs
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws
NEXT_PUBLIC_APP_NAME=PCAP Reporter
NEXT_PUBLIC_APP_VERSION=1.0.0

# CORS Settings
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# =============================================================================
# DOCKER USER MAPPING
# =============================================================================

# User ID mapping for Docker containers (run 'id' command to get your values)
USER_ID=1000
GROUP_ID=1000

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL Certificate paths (if using custom certificates)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
SSL_DHPARAM_PATH=/etc/nginx/ssl/dhparam.pem

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Celery Worker Configuration
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_MAX_MEMORY_PER_CHILD=800000  # 800MB

# Database Connection Pool
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=10000
DB_SERVER_SELECTION_TIMEOUT=5000

# Redis Memory Configuration
REDIS_MAX_MEMORY=512mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Prometheus Configuration
PROMETHEUS_RETENTION_TIME=200h
PROMETHEUS_STORAGE_PATH=/prometheus

# Grafana Configuration
GF_SECURITY_ADMIN_USER=${GRAFANA_USER}
GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_PASSWORD}
GF_USERS_ALLOW_SIGN_UP=false

# Log Levels
BACKEND_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO
NGINX_LOG_LEVEL=warn

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backup

# Cleanup Configuration
CLEANUP_OLD_REPORTS_DAYS=30
CLEANUP_OLD_UPLOADS_DAYS=7
CLEANUP_SCHEDULE=0 3 * * 0  # Weekly on Sunday at 3 AM

# =============================================================================
# EXTERNAL SERVICES (OPTIONAL)
# =============================================================================

# Email Configuration (for notifications)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@your-domain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@your-domain.com

# Webhook Configuration (for external integrations)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com/pcap-analysis
WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# DOMAIN & NETWORK CONFIGURATION
# =============================================================================

# Your domain name
DOMAIN_NAME=your-domain.com
SUBDOMAIN=pcap  # Will create pcap.your-domain.com

# Network Configuration
DOCKER_NETWORK_SUBNET=172.20.0.0/16
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Container Memory Limits (for Docker Compose)
API_MEMORY_LIMIT=2G
API_MEMORY_RESERVATION=1G
WORKER_MEMORY_LIMIT=4G
WORKER_MEMORY_RESERVATION=2G
MONGODB_MEMORY_LIMIT=2G
MONGODB_MEMORY_RESERVATION=1G
REDIS_MEMORY_LIMIT=768M
REDIS_MEMORY_RESERVATION=512M

# Container CPU Limits
API_CPU_LIMIT=1.0
API_CPU_RESERVATION=0.5
WORKER_CPU_LIMIT=2.0
WORKER_CPU_RESERVATION=1.0