# Production Environment Configuration
# Copy this file to .env.prod and fill in the actual values

# Security
SECRET_KEY=your-very-secure-secret-key-here
JWT_SECRET=your-jwt-secret-key-here

# Database
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-secure-mongodb-password
DATABASE_URL=mongodb://admin:your-secure-mongodb-password@mongodb:27017/pcap_reporter_prod?authSource=admin

# Redis
REDIS_URL=redis://redis:6379/0

# Application
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# File Upload
UPLOAD_MAX_SIZE=2147483648  # 2GB in bytes
UPLOAD_PATH=/app/uploads
UPLOAD_ALLOWED_EXTENSIONS=.pcap,.pcapng,.cap

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-grafana-password

# SSL/TLS
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# Domain
DOMAIN=your-domain.com
SUBDOMAIN=www.your-domain.com

# Email (for SSL certificate notifications)
EMAIL=admin@your-domain.com

# Backup
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Performance
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1024
CELERY_CONCURRENCY=4

# Security Headers
HSTS_MAX_AGE=31536000
CSP_POLICY="default-src 'self' https: data: blob: 'unsafe-inline'"

# Rate Limiting
RATE_LIMIT_API=10/s
RATE_LIMIT_UPLOAD=2/s
RATE_LIMIT_GENERAL=30/s 